                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and (ecu:get(&apos;Port.Family&apos;)=string('m243') or ecu:get(&apos;Port.Family&apos;)=string('m244'))" true="XTAL"/>

                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and ecu:get(&apos;Port.Family&apos;)=116" true="XTAL"/>

                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and ecu:get(&apos;Port.Family&apos;)=118" true="XTAL"/>

                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and ecu:get(&apos;Port.Family&apos;)=142" true="XTAL"/>

                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and ecu:get(&apos;Port.Family&apos;)=144" true="XTAL"/>

                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and ecu:get(&apos;Port.Family&apos;)=146" true="XTAL"/>

                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and ecu:get(&apos;Port.Family&apos;)=148" true="XTAL"/>

                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and ecu:get(&apos;Port.Family&apos;)=string('142w')" true="XTAL"/>

                                  <a:tst expr="node:fallback(../PortPinPcr, 0) = 0 and ecu:get(&apos;Port.Family&apos;)=string('144w')" true="XTAL"/>

                              </a:da>
                              <a:da name="WARNING" type="XPath">
                                 <a:tst expr="(text:uniq((node:fallback(../../*/PortPinMode,text:split('1 2 3'))), node:fallback(.,0)) or (.='GPIO') or (.='DISABLED'))" false="This functionality is configured on more than one pin. Usually, a functionality is configured on one single pin. Please make sure this is the desired configuration."/>
                              </a:da>
                          </v:var>
                          <v:var name="PortPinDSE" type="ENUMERATION">
                            <a:a name="LABEL" value="PortPin DSE"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Selects the drive strenght length value for this pin.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:caccf054-d0bc-4213-b3b9-d24664d1f4a6"/>
                            <a:da name="DEFAULT" value="Low_Drive_Strength"/>
                            <a:da name="EDITABLE" type="XPath" expr="contains(concat(',',string(ecu:get('Port.PinsWithDriveStrengthControl')),','),concat(',',node:fallback(../PortPinPcr,0),',')) = true()"/>
                            <a:da name="RANGE">
                              <a:v>Low_Drive_Strength</a:v>
                              <a:v>High_Drive_Strength</a:v>
                            </a:da>
                          </v:var>
                          <v:var name="PortPinPE" type="ENUMERATION">
                            <a:a name="LABEL" value="PortPin PE"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Selects if the pull-up or pull-down resistors are enabled.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:b4746397-1ca8-4f0e-b6e6-1bf25b86280f"/>
                            <a:da name="DEFAULT" value="PullDisabled"/>
                            <a:da name="RANGE">
                              <a:v>PullDisabled</a:v>
                              <a:v>PullEnabled</a:v>
                            </a:da>
                          </v:var>
                          <v:var name="PortPinPS" type="ENUMERATION">
                            <a:a name="LABEL" value="PortPin PS"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Selects between the pull-up and pull-down resistors. Only valid when PortPin PE is set to 'PullEnabled'.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:f333f98f-85a3-44a5-9d7d-fa9bc1f1ff0e"/>
                            <a:da name="DEFAULT" value="PullDown"/>
                            <a:da name="EDITABLE" type="XPath" expr="contains(node:fallback(../PortPinPE,'PullEnabled'),'PullEnabled') = true()"/>
                            <a:da name="RANGE">
                              <a:v>PullDown</a:v>
                              <a:v>PullUp</a:v>
                            </a:da>
                          </v:var>
                          <v:var name="PortPinSlewRate" type="ENUMERATION">
                            <a:a name="LABEL" value="PortPin Slew Rate"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Configures Slew Rate for the configured Pin.
                                        This is an implementation specific parameter.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:d9fbfbe1-2a94-4851-a058-06c9249519f6"/>
                            <a:da name="DEFAULT" value="FAST_SLEW_RATE"/>
                            <a:da name="RANGE">
                                <a:v>FAST_SLEW_RATE</a:v>
                                <a:v>SLOW_SLEW_RATE</a:v>
                            </a:da>
                            <a:da name="EDITABLE" type="XPath">
                              <a:tst expr="(ecu:get('Port.Family') = 'm244') or (ecu:get('Port.Family') = 'm242')" true='true'/>
                            </a:da>
                          </v:var>
                          <!-- @implements PortPinDirection_Object -->
                          <v:var name="PortPinDirection" type="ENUMERATION">
                            <a:a name="LABEL" value="PortPin Direction"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Selects the direction of the pin (IN, OUT, HIGH_Z) that will be configured by Port_Init() function if the pin is configured as GPIO.
                                        If the direction is not changeable, the value configured here is fixed. For the Alternative Function modes (PortPinMode is different than GPIO),
                                        the setting in this enumeration control is kept in the port configuration structure and it is used when Port_SetPinMode() is called at runtime to change the mode of the pin to GPIO.
                                        Set input pin to high-Z not available in S32K11X
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:0cfe73dc-655e-43ab-baed-789ca07dee13"/>
                            <a:da name="DEFAULT" value="PORT_PIN_IN"/>
                            <a:da name="RANGE" type="XPath">
                                <a:tst expr="0 = 0" true="PORT_PIN_IN"/>
                                <a:tst expr="0 = 0" true="PORT_PIN_OUT"/>
                                <a:tst expr="ecu:get(&apos;Port.Family&apos;)=118 or ecu:get(&apos;Port.Family&apos;)=116" false="PORT_PIN_HIGH_Z"/>
                            </a:da>
                          </v:var>
                          <v:var name="PortPinInitialMode" type="ENUMERATION">
                            <a:a name="LABEL" value="PortPin Initial Mode"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Port pin mode from mode list for use with Port_Init() function.
                                        NOTE: This parameter is not used in the current implementation and is retained as per std
                                        AUTOSAR_EcucParamDef.arxml file.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID"
                                 value="ECUC:6cd72f23-c7c8-4857-9d7c-8c66b37433c5"/>
                            <a:da name="DEFAULT" value="PORT_GPIO_MODE"/>
                            <a:da name="READONLY" value="true"/>
                            <a:da name="RANGE">
                              <a:v>PORT_GPIO_MODE</a:v>
                              <a:v>PORT_ALT1_FUNC_MODE</a:v>
                              <a:v>PORT_ALT2_FUNC_MODE</a:v>
                              <a:v>PORT_ALT3_FUNC_MODE</a:v>
                              <a:v>PORT_ALT4_FUNC_MODE</a:v>
                              <a:v>PORT_ALT5_FUNC_MODE</a:v>
                              <a:v>PORT_ALT6_FUNC_MODE</a:v>
                              <a:v>PORT_ALT7_FUNC_MODE</a:v>
                            </a:da>
                          </v:var>
                          <!-- @implements PortPinLevelValue_Object -->
                          <v:var name="PortPinLevelValue" type="ENUMERATION">
                            <a:a name="LABEL" value="PortPin Level Value"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Port Pin Level value from Port pin list.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID"
                                 value="ECUC:d972f884-30ee-4835-b2f5-26a3ab5441c9"/>
                            <a:da name="DEFAULT" value="PORT_PIN_LEVEL_LOW"/>
                            <a:da name="RANGE">
                              <a:v>PORT_PIN_LEVEL_HIGH</a:v>
                              <a:v>PORT_PIN_LEVEL_LOW</a:v>
                              <a:v>PORT_PIN_LEVEL_NOTCHANGED</a:v>
                            </a:da>
                            <a:da name="EDITABLE" type="XPath" expr="contains(node:fallback(../PortPinMode,'ADC'),'ADC') = false()"/>
                          </v:var>
                          <!-- @implements PortPinEcucPartitionRef_Object -->
                          <v:lst name="PortPinEcucPartitionRef">
                            <a:da name="INVALID" type="XPath">
                                 <a:tst expr="(num:i(count(./*)) = 0) and (num:i(count(../../../../../../PortGeneral/PortEcucPartitionRef/*)) > 0)" true="At  least one partition need to be defined in PortPinEcucPartitionRef"/>
                            </a:da>
                            <v:ref name="PortPinEcucPartitionRef" type="REFERENCE">
                              <a:a name="DESC">
                                <a:v>
                                  <![CDATA[EN:
                                    <html>
                                      <p>EN: Maps the Port pin to zero a multiple ECUC partitions. The ECUC partitions referenced are a subset of the ECUC  partitions where the Port driver is mapped to.</p>
                                      <p> EN: Tags: atp.Status=draft </p>
                                      <h1>Note</h1>The S32K1 platform will not support the MultiPartition feature.
                                    </html>
                                  ]]>
                                </a:v>
                                <a:v>EN: Tags: atp.Status=draft</a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                              <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="UUID" value="ECUC:14ac32hh-619e-4029-a793-3531090384zd"/>
                              <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                              <a:da name="INVALID" type="XPath">
                                  <a:tst expr="text:uniq(../*, .)" false="Duplicate Partition."/>
                                  <a:tst expr="count(text:grep(../../../../../../../PortGeneral/PortEcucPartitionRef/*,.)) > 0"
                                  false="The ECUC partition must be defined on the PortEcucPartitionRef."/>
                              </a:da>
                            </v:ref>
                          </v:lst>
                         </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                  <!-- @implements UnTouchedPortPin_Object -->
                  <v:lst name="UnTouchedPortPin" type="MAP">
                    <a:da name="MIN" value="0"/>
                    <v:ctr name="UnTouchedPortPin" type="IDENTIFIABLE">
                        <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:
                                  <html>
                                    <p>
                                        List containing Pins that will not be touched by Port_Init() function.
                                    </p>
                                  </html>
                                  ]]>
                            </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:v name="LOWER-MULTIPLICITY" value="1"/>
                        <a:v name="UPPER-MULTIPLICITY" value="*"/>
                        <a:a name="UUID"
                             value="ECUC:d9c0881a-4bdf-473c-affd-831994ab4064"/>
                        <v:var name="PortPinPcr" type="INTEGER">
                            <a:a name="LABEL" value="PortPin Pcr"/>
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:
                                        <html>
                                          <p>
                                            Used to specify the PCR (Port Configuration Register) for the configured pin.
                                          </p>
                                        </html>
                                        ]]>
                                </a:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:ad244e5b-63e5-4634-9012-z115f9a7a30a"/>
                            <a:da name="DEFAULT" type="XPath" expr="num:i((node:fallback(node:current()/../@index, '0')) + (count(node:fallback(../../../UnTouchedPortPin/*/PortPinPcr,text:split('1 2 3')))) - count(node:fallback(../../*,text:split('1 2 3'))))"/>
                            <a:da name="RANGE" type="XPath">
                              <a:tst expr="contains(concat(',',string(ecu:get(&apos;Port.NotAvailablePins&apos;)),','),concat(',',node:fallback(.,0),','))" true ="Invalid Pin number for current package. Please see RM for a list of available channels for this package."/>
                              <a:tst expr="text:uniq((node:fallback(../../*/PortPinPcr,text:split('1 2 3'))), node:fallback(.,0))" false="Error in UnTouchedPortPin list:  Pcr is repeated for two or more port pins"/>
                            </a:da>
                            <a:da name="INVALID" type="Range">
                                <a:tst expr="&gt;=0"/>
                                <a:tst expr="&lt;=num:i(ecu:list(&apos;Port.MaxPinNumber&apos;)[1])"/>
                            </a:da>
                        </v:var>
                    </v:ctr>
                  </v:lst>
                  <v:lst name="DigitalFilter" type="MAP">

                  <v:ctr name="DigitalFilter" type="IDENTIFIABLE">
                      <a:a name="LABEL" value="Digital Filter "/>
                      <a:a name="DESC"><a:v><![CDATA[EN:
                          <html>
Configuration of a Digital Filter module available on the platfom.
                          </html> ]]>
                          </a:v>
                      </a:a>
                      <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="UUID" value="ECUC:8Adf4b6e-2444-4123-9bd6-eb81a98252d0"/>
                      <v:var name="DigitalFilterPort" type="STRING">
                        <a:a name="LABEL" value="Digital Filter Port"/>
                        <a:a name="DESC">
                          <a:v><![CDATA[EN:
                          <html>
Selects one of the PORTs available on the platform.
                          </html> ]]>
                          </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="NXP"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:5aa68d86-f20c-45bf-a4a8-d6a73cbc99ee"/>
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="text:uniq(../../*/DigitalFilterPort, .)" false="Duplicate Port module"/>
                        </a:da>
                        <!--  default value - increment the last channel used -->
                        <a:da name="DEFAULT" type="XPath" expr="(ecu:list('Port.PortsWithDigitalInputFilter'))[position()-1=node:fallback(node:current()/../@index,'0')]">
                        </a:da>

                        <a:da name="RANGE" type="XPath" expr="ecu:list('Port.PortsWithDigitalInputFilter')"/>
                      </v:var>
                      <v:var name="DigitalFilterClock" type="ENUMERATION">
                          <a:a name="LABEL" value="Digital Filter Clock Selection"/>
                          <a:a name="DESC">
                          <a:v>
                                  <![CDATA[EN:
                                    <html>
                                      <p>
                                        Configures the clock source for the digital input filters.
                                      </p>
                                    </html>
                                  ]]>
                          </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="NXP"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:59582e32-abb3-43cc-b241-9f873b94512b"/>
                          <a:da name="DEFAULT" value="BUS_CLOCK"/>
                          <a:da name="RANGE">
                            <a:v>BUS_CLOCK</a:v>
                            <a:v>LPO_CLOCK</a:v>
                          </a:da>
                      </v:var>
                      <v:var name="DigitalFilterWidth" type="INTEGER">
                        <a:a name="LABEL" value="Digital Filter Width"/>
                        <a:a name="DESC">
                          <a:v><![CDATA[EN:
                              <html>
    Configures the maximum size of the glitches, in clock cycles, that the digital filter absorbs for the enabled digital filters. Glitches that are longer than this register setting will pass through the digital filter, and glitches that are equal to or less than this register setting are filtered.
                              </html> ]]>
                        </a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="NXP"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:8c8f66a7-1546-40d8-b4d5-0ed2316a046e"/>
                      <a:da name="DEFAULT" value="0"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=31"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>

                    <v:lst name="DigitalFilterChannel" type="MAP">
                        <v:ctr name="DigitalFilterChannel" type="IDENTIFIABLE">
                          <a:a name="LABEL" value="Digital Filter Channel"/>
                          <a:a name="DESC"><a:v><![CDATA[EN:
                              <html>
    Configuration of a Digital Filter channel available on the platfom.
                              </html> ]]>
                              </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:v name="LOWER-MULTIPLICITY" value="1"/>
                          <a:v name="UPPER-MULTIPLICITY" value="*"/>
                          <a:a name="UUID" value="ECUC:8Bdf4b51-2333-4123-9bd6-eb81a98252d0"/>
                          <v:var name="DigitalFilterChannelIndex" type="INTEGER">
                            <a:a name="LABEL" value="Digital Filter Channel"/>
                            <a:a name="DESC">
                              <a:v><![CDATA[EN:
                                  <html>
                                    Selects the channel in the port for which Digital Filter will be enabled.
                                  </html> ]]>
                              </a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="NXP"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" value="ECUC:8c8f66a7-1546-40e8-b4d5-0ed2316a0461"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index,'0')">
                              </a:da>
                              <a:da name="INVALID" type="Range">
                                   <a:tst expr="&lt;=31"/>
                                   <a:tst expr="&gt;=0"/>
                               </a:da>
                               <a:da name="RANGE" type="XPath">
                                    <a:tst expr="text:uniq(../../*/DigitalFilterChannelIndex, .)" false="Duplicate Port channel"/>
                               </a:da>
                            </v:var>
                        </v:ctr>
                    </v:lst>
                  </v:ctr>
                 </v:lst>
                </v:ctr>

              <!-- @implements PortGeneral_Object -->
              <v:ctr name="PortGeneral" type="IDENTIFIABLE">
                <a:a name="DESC">
                  <a:v>
                    <![CDATA[EN:
                        <html>
                          <p>
                            Module wide configuration parameters of the PORT driver.
                          </p>
                        </html>
                        ]]>
                  </a:v>
                </a:a>
                <a:a name="UUID" value="ECUC:e3c10b86-4c44-4565-a548-bfa05f87f5e3"/>
                <!-- @implements PortDevErrorDetect_Object -->
                <v:var name="PortDevErrorDetect" type="BOOLEAN">
                  <a:a name="LABEL" value="Port Development Error Detect"/>
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                              Switches the Development Error Detection and Notification ON or OFF.
                            </p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:397b9409-f9d5-498d-8eae-901541b11a43"/>
                  <a:da name="DEFAULT" value="true"/>
                </v:var>
                <!--  @implements PortCiPortIPDevErrorDetect_Object  -->
                <v:var name="PortCiPortIPDevErrorDetect" type="BOOLEAN">
                  <a:a name="LABEL" value="PORT CI IP Port Development Error Detect" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                                                <html><p>
                                                    Enables and Disables DevAssert checks in IP code.<br>
                                                    True: Enabled.<br>
                                                    False: Disabled.<br>
                                                </p></html>
                                            ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:068j841e-9f94-429d-b5a8-ch0387eefd19" />
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <!-- @implements PortSetPinDirectionApi_Object -->
                <v:var name="PortSetPinDirectionApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port SetPinDirection Api"/>
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                              Pre-processor switch to enable/disable the use of the function Port_SetPinDirection().
                            </p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:afb45cdf-e24f-4a70-ab45-cb4ac0c55db6"/>
                  <a:da name="DEFAULT" value="true"/>
                </v:var>
                <!-- @implements PortSet2PinsDirectionApi_Object -->
                <v:var name="PortSet2PinsDirectionApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port Set2PinsDirection Api"/>
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                              Pre-processor switch to enable/disable the use of the function Port_Set2PinsDirection().
                            </p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:bfb45cdf-e24f-4a70-ab45-ab4ac0c55db6"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:a name="EDITABLE" type="XPath">
                    <a:tst expr="(ecu:has('Port.Set2PinsDirectionApiAvailable') and ecu:get('Port.Set2PinsDirectionApiAvailable') = 'true')"/>
                  </a:a>
                </v:var>
                <!-- @implements PortSetPinModeApi_Object -->
                <v:var name="PortSetPinModeApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port SetPinMode Api"/>
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                              Pre-processor switch to enable/disable the use of the function Port_SetPinMode().
                            </p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:e77b32ca-cb08-44ae-ae6a-ee97ddbb3de0"/>
                  <a:da name="DEFAULT" value="true"/>
                </v:var>
                <!-- @implements PortVersionInfoApi_Object -->
                <v:var name="PortVersionInfoApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port VersionInfo Api"/>
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                               Pre-processor switch to enable/disable the API to read out the modules version information.
                            </p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:033c9c30-7d5b-4081-9484-7cd06f57bea7"/>
                  <a:da name="DEFAULT" value="true"/>
                </v:var>
                <!-- @implements PortSetPinModeDoesNotTouchGpioLevel_Object -->
                <v:var name="PortSetPinModeDoesNotTouchGpioLevel" type="BOOLEAN">
                  <a:a name="LABEL" value="Port SetPinMode Does Not Touch GPIO Levels"/>
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                               Pre-processor switch. When not checked, the function Port_SetPinMode() will set the output level of the pin to the value configured in the PortPinLevelValue combo when called at run time to change mode of a pin from alternate function to GPIO. When checked, the function Port_SetPinMode() will not touch the output level of the pin when called at run time to change mode of a pin from alternate function to GPIO.
                            </p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:2c37b26f-6cb3-4634-b20b-b635599a9f1b"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <!-- @implements PortSetAsUnusedPinApi_Object -->
                <v:var name="PortSetAsUnusedPinApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port Set As Unused Pin API"/>
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                              Pre-processor switch to enable/disable the use of the function Port_SetAsUnusedPin() and Port_SetAsUsedPin(). The function Port_SetAsUnusedPin shall configure the referenced pin with all the properties specified in the NotUsedPortPin container. The function Port_SetAsUsedPin shall configure the referenced pin with all the properties that where set during the Port_Init operation.</p>
                                    <p>TRUE: Enabled - Functions Port_SetAsUnusedPin() and Port_SetAsUsedPin() are available.</p>
                                    <p>FALSE: Disabled - Functions Port_SetAsUnusedPin() and Port_SetAsUsedPin() are not available.</p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:1f7dy044-d03f-43b6-889f-d9376j1d2776"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <!-- @implements PortResetPinModeApi_Object -->
                <v:var name="PortResetPinModeApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Port Reset Pin Mode API"/>
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                              Pre-processor switch to enable/disable the use of the function Port_ResetPinMode(). The function Port_ResetPinMode shall revert the port pin mode of the referenced pin to the value that was set by Port_Init operation.</p>
                                    <p>TRUE: Enabled - Function Port_ResetPinMode() is available.</p>
                                    <p>FALSE: Disabled - Function Port_ResetPinMode() is not available.</p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:1f7dy044-d03f-43b6-863k-d9376j9d2776"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <!-- @implements PortEnableUserModeSupport_Object -->
                <v:var name="PortEnableUserModeSupport" type="BOOLEAN">
                    <a:a name="DESC">
                        <a:v>
                            <![CDATA[EN:<html>
                                This parameter is added in Port configuration in order to keep a consistent design over the entire set of RTD drivers.
                                It cannot be configured by the user and is always set to 'false'.
                                There are no registers used by the driver which require special measures in order to be accessed from user mode, so Port driver can be run from either user or supervisor mode.<p/>
                            </html>]]>
                        </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="LABEL" value="Enable Port User Mode Support"/>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:2c37b26f-6cb3-4634-b20b-b636699a9f1c"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="READONLY" value="true"/>
                </v:var>
                <!-- @implements PortMultiPartitionSupport_Object -->
                <v:var name="PortMultiPartitionSupport" type="BOOLEAN">
                  <a:a name="DESC">
                  <a:v><![CDATA[EN:<html><p>This parameter globally enables the possibility to support MultiPartition. If this parmeter is enabled, at least one EcucPartition needs to be defined (in all variants).<br>
                        </p></html>]]></a:v>
                  </a:a>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="LABEL" value="Port MultiPartition Support"/>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:8419de9b-c7a1-4ab0-9e80-145z38e0z2zb" />
                  <a:da name="DEFAULT" value="false" />
                  <a:a name="INVALID" type="XPath">
                    <a:tst expr="(. = 'true') and not(num:i(count(../../PortGeneral/PortEcucPartitionRef/*) > 0))"
                          true="Port MultiPartition Support is only enabled when at least one EcucPartition needs to be defined (in all variants)."/>
                  </a:a>
                </v:var>
                <!-- @implements PortEcucPartitionRef_Object -->
                <v:lst name="PortEcucPartitionRef">
                  <v:ref name="PortEcucPartitionRef" type="REFERENCE">
                    <a:a name="DESC">
                        <a:v>
                            <![CDATA[EN:
                            <html>
                            <p>Maps the Port driver to zero a multiple ECUC partitions to make the modules API available in this partition.</p>
                            <p> Tags: atp.Status=draft </p>
                            <h1>Note</h1>The S32K1 platform will not support the MultiPartition feature.
                            </html>
                            ]]>
                        </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="UUID"
                         value="ECUC:f86d725b-aie5-4f3f-a6i6-0f491v2l8563"/>
                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                    <a:da name="INVALID" type="XPath">
                       <a:tst expr="text:uniq(../*, .)" false="Duplicate Partition."/>
                       <a:tst expr="node:containsValue(as:modconf('Os')[1]/OsApplication/*/OsAppEcucPartitionRef, .)"
                             false="The referenced ECUC partition isn't used by any OsApplication (i.e. Os/OsApplication/*/OsAppEcucPartitionRef)"/>
                       <a:tst expr="../../../PortGeneral/PortMultiPartitionSupport" false="The Port MultiPartition Support parameter is not enabled"/>
                    </a:da>
                  </v:ref>
                </v:lst>
              </v:ctr>
              <!-- @implements CommonPublishedInformation_Object -->
              <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                <a:a name="DESC">
                  <a:v>
                    <![CDATA[EN:
                        <html>
                          <p>
                            Common container, aggregated by all modules. It contains published information about vendor and versions.
                          </p>
                        </html>
                        ]]>
                  </a:v>
                </a:a>
                <a:a name="UUID" value="ECUC:1c339b59-5522-4ca8-b8c7-e083b5421181"/>
                <v:var name="ArReleaseMajorVersion" type="INTEGER_LABEL">
                  <a:a name="LABEL" value="AUTOSAR Major Version"/>
                  <a:a name="DESC">
                      <a:v>
                      <![CDATA[EN:
                          <html>
                             <p>
                               Major version number of AUTOSAR specification on which the appropriate implementation is based on.
                             </p>
                          </html>
                      ]]>
                      </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:3d08ad30-d4d4-41d5-a7c1-bf9c4301c684"/>
                  <a:da name="DEFAULT" value="4"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&gt;=4"/>
                    <a:tst expr="&lt;=4"/>
                  </a:da>
                </v:var>
                <v:var name="ArReleaseMinorVersion" type="INTEGER_LABEL">
                  <a:a name="LABEL" value="AUTOSAR Minor Version"/>
                  <a:a name="DESC">
                      <a:v><![CDATA[EN:
                           <html>
                               <p>
                                 Minor version number of AUTOSAR specification on which the appropriate implementation is based on.
                               </p>
                           </html>
                      ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:02d5d986-ea08-499e-8011-9d0a11a7fb17"/>
                  <a:da name="DEFAULT" value="7"/>
                  <a:da name="INVALID" type="Range">
                      <a:tst expr="&gt;=7"/>
                      <a:tst expr="&lt;=7"/>
                  </a:da>
                </v:var>
                <v:var name="ArReleaseRevisionVersion" type="INTEGER_LABEL">
                  <a:a name="LABEL" value="AUTOSAR Revision Version"/>
                  <a:a name="DESC">
                      <a:v><![CDATA[EN:
                        <html>
                            <p>
                                Revision version number of AUTOSAR specification on which the appropriate implementation is based on.
                            </p>
                        </html>
                      ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:7a8fd075-5f53-4aea-b487-fa752b9ed5ac"/>
                  <a:da name="DEFAULT" value="0"/>
                  <a:da name="INVALID" type="Range">
                      <a:tst expr="&gt;=0"/>
                      <a:tst expr="&lt;=0"/>
                  </a:da>
                </v:var>
                <v:var name="ModuleId" type="INTEGER_LABEL">
                  <a:a name="LABEL" value="Module Id."/>
                  <a:a name="DESC">
                      <a:v><![CDATA[EN:
                               <html>
                                   <p>
                                     Module ID of this module from Module List.
                                   </p>
                               </html>
                      ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:38feb68b-87ef-4fdc-b703-afdca23c0b6a"/>
                  <a:da name="DEFAULT" value="124"/>
                  <a:da name="INVALID" type="Range">
                      <a:tst expr="&gt;=124"/>
                      <a:tst expr="&lt;=124"/>
                  </a:da>
                </v:var>
                <v:var name="SwMajorVersion" type="INTEGER_LABEL">
                  <a:a name="LABEL" value="Software Major Version"/>
                  <a:a name="DESC">
                      <a:v><![CDATA[EN:
                        <html>
                            <p>
                                Major version number of the vendor specific implementation of the module. The numbering is vendor specific.
                            </p>
                        </html>
                      ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:316672f8-d3fa-49e3-9be8-7b4c3bd6dd1f"/>
                  <a:da name="DEFAULT" value="3"/>
                  <a:da name="INVALID" type="Range">
                      <a:tst expr="&gt;=3"/>
                      <a:tst expr="&lt;=3"/>
                  </a:da>
                </v:var>
                <v:var name="SwMinorVersion" type="INTEGER_LABEL">
                  <a:a name="LABEL" value="Software Minor Version"/>
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:
                        <html>
                            <p>
                                Minor version number of the vendor specific implementation of the module. The numbering is vendor specific.
                            </p>
                        </html>
                        ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:cacc1711-4c7f-401e-ae1d-c8e18a7ed89b"/>
                  <a:da name="DEFAULT" value="0"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&gt;=0"/>
                    <a:tst expr="&lt;=0"/>
                  </a:da>
                </v:var>
                <v:var name="SwPatchVersion" type="INTEGER_LABEL">
                  <a:a name="LABEL" value="Software Patch Version"/>
                  <a:a name="DESC">
                    <a:v><![CDATA[EN:
                       <html>
                       <p>
                           Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific.
                       </p>
                       </html>
                    ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:9cdf53e7-bada-4b8d-9926-0b49395d2531"/>
                  <a:da name="DEFAULT" value="0"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&gt;=0"/>
                    <a:tst expr="&lt;=0"/>
                  </a:da>
                </v:var>
                <v:var name="VendorApiInfix" type="STRING_LABEL">
                  <a:a name="LABEL" value="Vendor Api Infix"/>
                  <a:a name="DESC">
                      <a:v><![CDATA[EN:
                      <html>
                          <p>
                          In driver modules which can be instantiated several times on a single ECU, BSW00347 requires that the name of APIs is extended by the VendorId and a vendor specific name.
                          This parameter is used to specify the vendor specific name. In total, the implementation specific name is generated as follows:
                          &lt;ModuleName&gt;_&gt;VendorId&gt;_&lt;VendorApiInfix&gt;&lt;Api name from SWS&gt;.
                          E.g.  assuming that the VendorId of the implementor is 123 and the implementer chose a VendorApiInfix of &quot;v11r456&quot; a api name Can_Write defined in the SWS will translate to Can_123_v11r456Write.
                          This parameter is mandatory for all modules with upper multiplicity &gt; 1. It shall not be used for modules with upper multiplicity =1.
                          </p>
                      </html>
                      ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v class="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:39faa4d7-a556-41b6-8641-58807934edd9"/>
                  <a:da name="DEFAULT" value=""/>
                </v:var>
                <v:var name="VendorId" type="INTEGER_LABEL">
                  <a:a name="LABEL" value="Vendor Id"/>
                    <a:a name="DESC">
                        <a:v><![CDATA[EN:
                                <html>
                                    <p>
                                        Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list.
                                    </p>
                                </html>
                        ]]></a:v>
                    </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                    <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                  </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:3b884dce-96d5-40ad-8fca-e77fb350f8a5"/>
                    <a:da name="DEFAULT" value="43"/>
                    <a:da name="INVALID" type="Range">
                        <a:tst expr="&gt;=43"/>
                        <a:tst expr="&lt;=43"/>
                    </a:da>
                </v:var>
              </v:ctr>
              <d:ref type="REFINED_MODULE_DEF" value="ASPath:/AUTOSAR/EcucDefs/Port"/>
            </v:ctr>
          </d:chc>
          <d:chc name="Port_EcuParameterDefinition"
                 type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
            <d:ctr type="AR-ELEMENT">
            <a:a name="UUID" value="ECUC:58b75c6b-5b20-4392-8edf-4cbaa0e59c99"/>
              <a:a name="DEF"
                   value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
              <d:lst name="MODULE_REF">
                <d:ref type="MODULE_REF" value="ASPath:/TS_T40D2M30I0R0/Port"/>
              </d:lst>
            </d:ctr>
          </d:chc>
          <d:chc name="Port_ModuleDescription"
                 type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
            <d:ctr type="AR-ELEMENT">
              <a:a name="DEF"
                   value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION"/>
              <d:var name="MODULE_ID" type="INTEGER" >
                <a:a name="EDITABLE" value="false"/>
                <a:a name="IMPORTER_INFO" value="@DEF"/>
              </d:var>
              <d:ref type="RECOMMENDED_CONFIGURATION" >
                <a:a name="EDITABLE" value="false"/>
                <a:a name="IMPORTER_INFO" value="@DEF"/>
              </d:ref>
              <d:ref type="PRE_CONFIGURED_CONF" >
                <a:a name="EDITABLE" value="false"/>
                <a:a name="IMPORTER_INFO" value="@DEF"/>
              </d:ref>
              <d:ref type="VENDOR_SPECIFIC_MODULE_DEF"
                     value="ASPath:/TS_T40D2M30I0R0/Port"/>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
