<?xml version='1.0'?>
<datamodel version="3.0"
           xmlns="http://www.tresos.de/_projects/DataModel2/08/root.xsd"
           xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd"
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
<!--
*   @file    Port.xdm
*   @version 3.0.0
*
*   @brief   AUTOSAR Port - Tresos Studio plugin schema file
*   @details This file contains the schema configuration for and Port Tresos Studio
*   plugin.
-->
<!--
====================================================================================================
*   Project              : RTD AUTOSAR 4.7
*   Platform             : CORTEXM
*   Peripheral           : PORT_CI
*   Dependencies         : none
*
*   Autosar Version      : 4.7.
*                          0
*   Autosar Revision     : ASR_REL_4_7_REV_0000
*   Autosar Conf.Variant :
*   SW Version           : 3.0.0
*   Build Version        : S32K1_RTD_3_0_0_QLP02_D2505_ASR_REL_4_7_REV_0000_20250530

*   Copyright 2020-2025 NXP
====================================================================================================
-->
  <d:ctr type="AUTOSAR" factory="autosar"
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="TS_T40D2M30I0R0" type="AR-PACKAGE">
      <a:a name="UUID" value="ECUC:6f4a881e-ce1c-45e6-a22c-2067c5217561"/>
      <d:lst type="ELEMENTS">
          <d:chc name="Port" type="AR-ELEMENT" value="MODULE-DEF">
          <v:ctr type="MODULE-DEF">
            <a:a name="RELEASE" value="asc:4.7"/>
             <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                      <ad:DATE>2014-10-31</ad:DATE>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <a:a name="DESC">
                 <a:v>
                    <![CDATA[EN:
                        <html>
                              <p>
                                  Configuration of the Port module.
                              </p>
                        </html>
                    ]]>
                 </a:v>
              </a:a>
              <a:a name="LOWER-MULTIPLICITY" value="1"/>
              <a:a name="UPPER-MULTIPLICITY" value="1"/>
              <a:a name="UUID" value="ECUC:d44da0ac-5ed0-46a3-868f-3f8e6825a30e"/>
              <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                <a:a name="DESC">
                  <a:v>
                    <![CDATA[EN:
                        <html>
                              <p>
                                Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points.
                              </p>
                        </html>
                    ]]>
                  </a:v>
                </a:a>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:a name="LABEL" value="Post Build Variant Used"/>
                    <a:a name="ORIGIN" value="EB"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="READONLY" value="FALSE"/>
                    <a:da name="TOOLTIP"
                          value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
              </v:var>
              <!-- /** @implements ConfigVariant_Object */ -->
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant"/>
                <a:a name="UUID" value="ECUC:7973a07f-5c3b-4b7f-8a9e-0be6e579b68f"/>
                <a:a name="DESC">
                  <a:v>
                    <![CDATA[EN:
                        <html>
                          <p>
                            VariantPreCompile: Only precompile time configuration parameters. Only one set of parameters.
                            VariantPostBuild: Mix of precompile and postbuild time configuration parameters. Only one set of parameters.
                            If Config Variant = VariantPreCompile, the files Port_Cfg.h and Port_Cfg.c should be used.
                            If Config Variant = VariantPostBuild, the files Port_Cfg.h and Port_PBcfg.c should be used.
                          </p>
                        </html>
                        ]]>
                  </a:v>
                </a:a>
                <a:da name="DEFAULT" value="VariantPostBuild"/>
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                  <a:v>VariantPreCompile</a:v>
                </a:da>
              </v:var>
                <!-- @implements PortConfigSet_Object -->
                <v:ctr name="PortConfigSet" type="IDENTIFIABLE">
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                          <html>
                            <p>
                              This container contains a configuration of the PORT driver.
                            </p>
                          </html>
                          ]]>
                    </a:v>
                  </a:a>
              <a:a name="UUID" value="ECUC:82f609dd-1ba9-4c5d-a62e-2cf1b909d399"/>
              <!-- @implements NotUsedPortPin_Object -->
              <v:ctr name="NotUsedPortPin" type="IDENTIFIABLE">
                <a:a name="DESC">
                <a:v>
                  <![CDATA[EN:
                    <html>
                      <p>
                        The init parameters values for the not used pins in the PORT configuration.
                      </p>
                    </html>
                  ]]>
                </a:v>
                </a:a>
                <a:a name="UUID" value="ECUC:1da6860f-28ea-4e59-9040-d385cbcf0867"/>
                <v:var name="PortPinMode" type="ENUMERATION">
                    <a:a name="LABEL" value="PortPin Mode"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                            <html>
                              <p>
                                Selects if the unused port pins are configured as GPIOs or are disabled.
                              </p>
                            </html>
                            ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:c4746397-1ca8-4f0e-b6e6-1bf25b86281f"/>
                    <a:da name="DEFAULT" value="GPIO"/>
                    <a:da name="RANGE">
                      <a:v>SKIP</a:v>
                      <a:v>GPIO</a:v>
                      <a:v>Disabled</a:v>
                    </a:da>
                </v:var>
                <v:var name="PortPinDirection" type="ENUMERATION">
                  <a:a name="LABEL" value="PortPin Direction"/>
                  <a:a name="DESC">
                  <a:v>
                          <![CDATA[EN:
                            <html>
                              <p>
                                Selects the initial direction of the pin (IN or OUT or HIGH_Z). If the direction is not
                                changeable, the value configured here is fixed.
                                The pin direction can be set only for the GPIO pins. For the Alternative Function
                                modes the OUT pin direction is hw selected.
                                If the HIGH_Z and IN direction is needed too, it can be set at runtime.
                                NOTE: To set the IN direction take care, please, that all the possible module
                                inputs, possible as Alternative Functions for the pad mode,
                                are hw connected together, if IN direction is enabled, to the pad.
                                Set input pin to high-Z not available in S32K11X
                              </p>
                            </html>
                          ]]>
                  </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:59582e32-cdb2-43cc-b241-9f873b94512b"/>
                  <a:da name="DEFAULT" value="PORT_PIN_IN"/>
                  <a:da name="RANGE" type="XPath">
                    <a:tst expr="0 = 0" true="PORT_PIN_IN"/>
                    <a:tst expr="0 = 0" true="PORT_PIN_OUT"/>
                    <a:tst expr="ecu:get(&apos;Port.Family&apos;)=118 or ecu:get(&apos;Port.Family&apos;)=116" false="PORT_PIN_HIGH_Z"/>
                  </a:da>
                </v:var>
                <v:var name="PortPinLevelValue" type="ENUMERATION">
                  <a:a name="LABEL" value="PortPin Level Value"/>
                  <a:a name="DESC">
                  <a:v>
                          <![CDATA[EN:
                            <html>
                              <p>
                                Port Pin Level value from Port pin list.
                              </p>
                            </html>
                          ]]>
                  </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="NXP"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID"
                           value="ECUC:768b8693-102e-4da9-bfd7-0b65949cd265"/>
                  <a:da name="DEFAULT" value="PORT_PIN_LEVEL_LOW"/>
                  <a:da name="EDITABLE" type="XPath" expr="contains(node:fallback(../PortPinDirection,'PORT_PIN_OUT'),'PORT_PIN_OUT') = true()"/>
                  <a:da name="RANGE">
                    <a:v>PORT_PIN_LEVEL_HIGH</a:v>
                    <a:v>PORT_PIN_LEVEL_LOW</a:v>
                  </a:da>
                </v:var>
                <v:var name="PortPinDSE" type="ENUMERATION">
                    <a:a name="LABEL" value="PortPin DSE"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                            <html>
                              <p>
                                Selects the drive strenght length value for this pin.
                              </p>
                            </html>
                            ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:3f85bf94-ba15-4e37-84b3-c2a15d26665d"/>
                    <a:da name="DEFAULT" value="Low_Drive_Strength"/>
                    <a:da name="RANGE">
                      <a:v>Low_Drive_Strength</a:v>
                      <a:v>High_Drive_Strength</a:v>
                    </a:da>
                </v:var>
                <v:var name="PortPinPE" type="ENUMERATION">
                    <a:a name="LABEL" value="PortPin PE"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                            <html>
                              <p>
                                Selects if the pull-up or pull-down resistors are enabled.
                              </p>
                            </html>
                            ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:b4746397-1ca8-4f0e-b6e6-1bf25b86281f"/>
                    <a:da name="DEFAULT" value="PullDisabled"/>
                    <a:da name="RANGE">
                      <a:v>PullDisabled</a:v>
                      <a:v>PullEnabled</a:v>
                    </a:da>
                  </v:var>
                <v:var name="PortPinPS" type="ENUMERATION">
                    <a:a name="LABEL" value="PortPin PS"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                            <html>
                              <p>
                                Selects between the pull-up and pull-down resistors. Only valid when PortPin PE is set to 'PullEnabled'.
                              </p>
                            </html>
                            ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="NXP"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:f333f98f-85a3-44a5-9d7d-fa9bc1f1ff1e"/>
                    <a:da name="DEFAULT" value="PullDown"/>
                    <a:da name="EDITABLE" type="XPath" expr="contains(node:fallback(../PortPinPE,'PullEnabled'),'PullEnabled') = true()"/>
                    <a:da name="RANGE">
                      <a:v>PullDown</a:v>
                      <a:v>PullUp</a:v>
                    </a:da>
                  </v:var>
              </v:ctr>
                  <v:lst name="PortContainer" type="MAP">
                    <a:da name="MIN" value="1"/>
                    <!-- @implements PortContainer_Object -->
                    <v:ctr name="PortContainer" type="IDENTIFIABLE">
                       <a:a name="DESC">
                        <a:v>
                          <![CDATA[EN:
                              <html>
                                <p>
                                  Container collecting the PortPins.
                                </p>
                              </html>
                              ]]>
                        </a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                    <a:v name="LOWER-MULTIPLICITY" value="1"/>
                    <a:v name="UPPER-MULTIPLICITY" value="*"/>
                      <a:a name="UUID"
                           value="ECUC:2737842e-8831-43f6-818b-360c8d030521"/>
                       <v:var name="PortNumberOfPortPins" type="INTEGER">
                        <a:a name="LABEL" value="PortNumberOfPortPins"/>
                        <a:a name="DESC">
                          <a:v>
                            <![CDATA[EN:
                                <html>
                                  <p>
                                    The number of specified PortPins in this PortContainer.
                                  </p>
                                </html>
                                ]]>
                          </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID"
                            value="ECUC:3b3ca607-57a9-4db5-9447-607b7a146417"/>
                        <a:da name="DEFAULT" type="XPath">
                            <a:tst expr="num:i(count(node:fallback(node:current()/../PortPin/*,text:split('1 2 3'))))"/>
                        </a:da>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&gt;=1"/>
                          <a:tst expr="&lt;= num:i(ecu:list(&apos;Port.MaxPinNumber&apos;)[1] + 1)"/>
                        </a:da>
                        <a:da name="RANGE" type="XPath">
                            <a:tst expr="node:fallback(., 1) = count(node:fallback(node:current()/../PortPin/*,text:split('1 2 3')))" false=" For calculating the correct value use the CALC button"/>
                        </a:da>
                        <a:da name="TOOLTIP" type="XPath" expr="num:i(num:i(count(node:current()/../PortPin/*)))">
                        </a:da>
                      </v:var>
                      <v:lst name="PortPin" type="MAP">
                        <a:da name="MIN" value="1"/>
                        <!-- @implements PortPin_Object -->
                        <v:ctr name="PortPin" type="IDENTIFIABLE">
                           <a:a name="REQUIRES-INDEX" value="true"/>
                           <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:
                                  <html>
                                    <p>
                                      Configuration of the individual port pins.
                                    </p>
                                  </html>
                                  ]]>
                            </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:v name="LOWER-MULTIPLICITY" value="1"/>
                          <a:v name="UPPER-MULTIPLICITY" value="*"/>
                          <a:a name="UUID"
                               value="ECUC:1f4e6882-83eb-47be-8357-781c391b57ed"/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="count(text:grep(as:paths(../../../../PortContainer/*/PortPin/*), concat('^.*/',name(.)))) > 1"
                              true="Duplicated PortPin Name"/>
                          </a:da>
                          <v:var name="PortPinPFE" type="BOOLEAN">
                            <a:a name="LABEL" value="PortPin Passive Filter Enable"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                        Passive Filter Enable
                                        Passive filter configuration is valid in all digital pin muxing modes.
                                        <h1>Note</h1>PORT_PCRn[PFE] is configurable for only PTA5 and PTD3. PFE for these should be configured in ALT7 mode only. For other modes, PFE should be kept 0.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:b3dbe90t-8ffe-445f-adse-19ffeb93f602"/>
                            <a:da name="DEFAULT" value="false"/>
                            <a:da name="EDITABLE" type="XPath" expr="contains(concat(',',string(ecu:get('Port.PinsWithPassiveFilter')),','),concat(',',node:fallback(../PortPinPcr,0),',')) = true()"/>
                            <a:da name="INVALID" type="XPath">
                                 <a:tst expr="(contains(concat(',',string(ecu:get('Port.PinsWithPassiveFilter')),','),concat(',',node:fallback(../PortPinPcr,0),',')) = false()) and (node:fallback(.,0) = 'true') " true="The PFE feature is not valid for this pin. Please open the IOMux excel file for more details."/>
                            </a:da>
                          </v:var>
                          <v:var name="PortPinODE" type="BOOLEAN">
                            <a:a name="LABEL" value="PortPin Ode"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Enable Open Drain Output for the configured Pin.
                                        Checked box means the Open Drain configuration is set.
                                        This is an implementation specific parameter.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:b3dbe90t-8ffe-445f-adse-19ffeb93f633"/>
                            <a:da name="DEFAULT" value="false"/>
                            <a:da name="EDITABLE" type="XPath">
                              <a:tst expr="(ecu:get('Port.Family') = 'm244') or (ecu:get('Port.Family') = 'm242')" true='true'/>
                           </a:da>
                          </v:var>
                          <v:var name="PortPinLK" type="BOOLEAN">
                            <a:a name="LABEL" value="PortPin Lock Register"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                        Lock Register Enable
                                        Pin Control Register fields [15:0] are locked and cannot be updated until the next system reset.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:b3dbe90t-8le-445f-adse-19ffhh96f602"/>
                            <a:da name="DEFAULT" value="false"/>
                          </v:var>
                          <!-- @implements PortPinDirectionChangeable_Object -->
                          <v:var name="PortPinDirectionChangeable" type="BOOLEAN">
                            <a:a name="LABEL" value="PortPin Direction Changeable"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Enable/Disable the changeability for the configured Pin. Checked box means the Direction Changeability is enabled.
                                        This is an implementation specific parameter. The changeable pin direction can be set only for the GPIO pins.
                                        For a mode different than GPIO, pin direction changeablity shall be disabled.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID"
                                 value="ECUC:eaafbf42-4ea9-4638-8af3-770a1b284394"/>
                            <a:da name="DEFAULT" value="true"/>
                            <a:da name="EDITABLE" type="XPath">
                                <a:tst expr="(../PortPinMode = 'GPIO')" true="true" false="false"/>
                            </a:da>
                          </v:var>
                          <!-- @implements PortPinModeChangeable_Object -->
                          <v:var name="PortPinModeChangeable" type="BOOLEAN">
                            <a:a name="LABEL" value="PortPin Mode Changeable"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Parameter to indicate if the mode of a port pin is changeable during runtime.
                                        True: Port Pin mode changeable allowed.
                                        False: Port Pin mode changeable not permitted
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID"
                                 value="ECUC:4caa0f0d-1e76-41eb-948e-ccbdb490b281"/>
                            <a:da name="DEFAULT" value="true"/>
                          </v:var>
                          <!-- @implements PortPinId_Object -->
                          <v:var name="PortPinId" type="INTEGER">
                            <a:a name="LABEL" value="PortPin Id"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Pin Id of the port pin.
                                        This value will be assigned to the symbolic name
                                        derived from the port pin container short name.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                            <a:a name="UUID"
                                 value="ECUC:0bde811c-95c2-4c78-a78b-6d14058ae758"/>
                            <a:da name="DEFAULT" type="XPath" expr="num:i((node:fallback(node:current()/../@index, '1')) + 1 + (count(node:fallback(../../../../*/PortPin/*/PortPinId,text:split('1 2 3')))) - count(node:fallback(../../*,text:split('1 2 3'))))"/>
                            <a:da name="INVALID" type="Range">
                                <a:tst expr="&gt;=1"/>
                                <a:tst expr="&lt;= num:i(ecu:list(&apos;Port.MaxPinNumber&apos;)[1] + 1)"/>
                            </a:da>
                            <a:da name="RANGE" type="XPath">
                                 <a:tst expr="text:uniq((node:fallback(../../../../*/PortPin/*/PortPinId,text:split('1 2 3'))), node:fallback(.,0))" false="The value of PortPinId is not unique for this configuration."/>
                                 <a:tst expr="node:fallback(., 0) &lt; (count(node:fallback(../../../../*/PortPin/*, text:split('1 2 3'))) + 1)" false="The value of PortPinId can't be higher than the number of defined pins"/>
                            </a:da>
                          </v:var>
                          <v:var name="PortPinPcr" type="INTEGER">
                            <a:a name="LABEL" value="PortPin Pcr"/>
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                    <html>
                                      <p>
                                        Used to specify the PCR (Port Configuration Register) for the configured pin.
                                      </p>
                                    </html>
                                    ]]>
                              </a:v>
                            </a:a>
                            <a:a name="ORIGIN" value="NXP"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                     <a:a name="UUID" value="ECUC:8cea96dd-b0be-42c6-906f-04f630160478"/>
                                     <a:da name="DEFAULT" type="XPath" expr="num:i((node:fallback(node:current()/../@index, '0') + 0) + (count(node:fallback(../../../../*/PortPin/*/PortPinPcr,text:split('1 2 3')))) - count(node:fallback(../../*,text:split('1 2 3'))))"/>
                            <a:da name="INVALID" type="Range">
                              <a:tst expr="&gt;=0"/>
                              <a:tst expr="&lt;=num:i(ecu:list(&apos;Port.MaxPinNumber&apos;)[1])"/>
                            </a:da>
                            <a:da name="RANGE" type="XPath">
                                       <a:tst expr="contains(concat(',',string(ecu:get(&apos;Port.NotAvailablePins&apos;)),','),concat(',',node:fallback(.,0),','))" true ="Invalid Pin number for current package. Please see RM for a list of available channels for this package."/>
                                       <a:tst expr="text:uniq((node:fallback(../../../../*/PortPin/*/PortPinPcr,text:split('1 2 3'))), node:fallback(.,0))" false="Error in PortPin list: PortPinPcr is repeated for two or more port pins"/>
                            </a:da>
                            <a:da name="WARNING" type="XPath">
                                 <a:tst expr="(((ecu:get('Port.Family') = 'm244') or (ecu:get('Port.Family') = 'm242')) and (contains(concat(',',ecu:get('Port.NotImplementedOnPartC'),','), concat(',',node:fallback(.,0),','))))" true="This pin only exists on part L: S32M242L_64lqfp_ep"/>
                            </a:da>
                          </v:var>
                          <!-- @implements PortPinMode_Object -->
                          <v:var name="PortPinMode" type="ENUMERATION">
