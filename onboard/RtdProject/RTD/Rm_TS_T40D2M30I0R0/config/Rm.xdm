<d:ctr type="AUTOSAR" factory="autosar"
    xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
    xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
    xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
    <d:lst type="TOP-LEVEL-PACKAGES">
        <d:ctr name="TS_T40D2M30I0R0" type="AR-PACKAGE">
            <a:a name="UUID" value="ECUC:b29f2c08-0514-4b78-8757-9cd197ea3150"/>
            <d:lst type="ELEMENTS">
                <!-- @implements Rm_Object -->
                <d:chc name="Rm" type="AR-ELEMENT" value="MODULE-DEF">
                    <v:ctr type="MODULE-DEF">
                        <a:a name="RELEASE" value="asc:4.7"/>
                        <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                            <ad:ADMIN-DATA>
                                <ad:DOC-REVISIONS>
                                    <ad:DOC-REVISION>
                                        <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                                        <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                        <ad:DATE>2014-10-31</ad:DATE>
                                    </ad:DOC-REVISION>
                                </ad:DOC-REVISIONS>
                            </ad:ADMIN-DATA>
                        </a:a>
                        <a:a name="DESC"
                             value="EN: Vendor specific: Configuration of the Rm (Resource Manager) module."/>
                        <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
                        <a:a name="UUID" value="ECUC:3543c3ac-3566-11ed-a261-0242ac120002"/>
                        <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                            <a:a name="DESC"
                                value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="LABEL" value="Post Build Variant Used"/>
                            <a:a name="ORIGIN" value="EB"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                            <a:da name="DEFAULT" value="false"/>
                            <a:da name="TOOLTIP"
                                value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                        </v:var>
                        <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                            <a:a name="LABEL" value="Config Variant"/>
                            <a:a name="UUID" value="ECUC:3543cc44-3566-11ed-a261-0242ac120002"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="DESC">
                                <a:v>
                                    <![CDATA[EN:<html>
                                        <p>VariantPostBuild: Mix of precompile and postbuild time configuration parameters.<br>
                                        </p>
                                    </html>]]>
                                </a:v>
                            </a:a>
                            <a:da name="DEFAULT" value="VariantPreCompile"/>
                            <a:da name="RANGE">
                                <a:v>VariantPostBuild</a:v>
                                <a:v>VariantPreCompile</a:v>
                            </a:da>
                        </v:var>

                        <v:ctr name="RmGeneral" type="IDENTIFIABLE">
                            <a:a name="DESC" value="EN: Vendor specific: Configuration of general Rm parameters."/>
                            <a:a name="UUID" value="ECUC:3543baba-3566-11ed-a261-0242ac120002"/>
                            <a:a name="LABEL" value="Rm General Configuration"/>
                            <a:da name="INVALID" type="XPath">
                                <a:tst expr="
                                (./RmEnableDmaMuxSupport ='false') and
                                'true'" 
                                true="At least one RM feature must be enabled!"/>
                            </a:da>
                            <v:var name="Rm_VersionInfoApi" type="BOOLEAN">
                                <a:a name="DESC" value="EN: Vendor specific: Enables/Disables the get version info API function"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:42da3770-7248-47fd-b1a8-8986ca635060"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <!-- @implements RmDevErrorDetect_Object -->
                            <v:var name="RmDevErrorDetect" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN: <html> Vendor specific:
                                        <p>Switches the Development Error Detection and Notification on or off.</p>
                                            <ul>
                                                <li>true: Enabled.</li>
                                                <li>false: Disabled.</li>
                                            </ul>
                                        </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="LABEL" value="Rm Development Error Detect"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:d8897d9d-1ae0-4020-85fc-70dfeb9f28fe"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <!-- EnableUserModeSupport -->
                            <!-- @implements RmEnableUserModeSupport_Object -->
                            <v:var name="RmEnableUserModeSupport" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html>
                                            When this parameter is enabled, the RM module will adapt to run from User Mode, with the following measures:<p/>
                                            b) using 'call trusted function' stubs for all internal function calls that access registers requiring supervisor mode.<p/>
                                            for more information, please see chapter 5.7 User Mode Support in IM <p/>
                                            Note: Implementation Specific Parameter.
                                        </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="LABEL" value="Rm Enable User Mode Support"/>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:fdf29f83-dbae-4cd2-abf2-c0941851a05e"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>


                            <!-- @implements RmEnableDmaMuxSupport_Object -->
                            <v:var name="RmEnableDmaMuxSupport" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html>
                                            When this parameter is enabled, the Dma Mux APIs are enabled to the user<p/>
                                        </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="LABEL" value="RM Enable DMA MUX Support"/>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" value="ECUC:00491bf1-bd7d-40fc-b24d-4d2f940fd9e4"/>
                                <a:da name="DEFAULT" value="false"/>
                            </v:var>

                            <!--  RmEnableGlobalInit -->
                            <v:var name="RmEnableGlobalInit" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html>
                                            Enable Global Init Support.<br>
                                            If the node is checked, Rm driver will support the API Rm_Init to initialize all IPs.<br>
                                            Otherwise Rm driver will support init functions separately for IPs.
                                        </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="LABEL" value="Rm Enable Global Init"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="UUID" value="ECUC:05f32a7c-873f-4678-32a2-d98c25c8811c"/>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:da name="DEFAULT" value="true"/>
                            </v:var>

                            <!-- @implements RmMultiPartitionSupport_Object -->
                            <v:var name="RmMultiPartitionSupport" type="BOOLEAN">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html>
                                            This parameter globally enables the possibility to support multi-partition.<p/>
                                            If this parmeter is enabled, at least one EcucPartition needs to be defined (in all variants).<p/>
                                            Note: Implementation Specific Parameter.<p/>
                                        </html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="LABEL" value="Rm Multi-Partition Support"/>
                                <a:a name="ORIGIN" value="NXP"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                <a:a name="UUID" value="ECUC:2ddfb87e-8520-4a0b-b5aa-94c0826c6871"/>
                                <a:da name="DEFAULT" value="false" />
                                <a:a name="EDITABLE" value="true"/>
                            </v:var>
                            <v:ref name="RmInitEcucPartitionRef" type="REFERENCE">
                                    <a:a name="DESC">
                                        <a:v>EN: Maps a config part of Rm_Init to ECUC partitions.</a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:da name="EDITABLE" type="XPath" expr="./../RmMultiPartitionSupport"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="OPTIONAL" value="true"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="UUID" value="ECUC:41ddf2e2-e20d-4c08-b65d-d2725503dd00"/>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="count(text:grep(../../RmConfigSet/RmEcucPartitionRef/*,.)) > 0" false="The ECUC partition must be defined on the RmEcucPartitionRef." />
                                    </a:da>
                                </v:ref>
                        </v:ctr>

                        <v:ctr name="RmConfigSet" type="IDENTIFIABLE">
                            <a:a name="DESC">
                                <a:v><![CDATA[EN: <html> Vendor specific: This container is the base for a multiple configuration set
                                    </html>]]>
                                </a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:b825a11b-5f5e-48b6-9c71-0e63b429c3da"/>
                            
                            <!-- @implements RmEcucPartitionRef_Object -->
                            <v:lst name="RmEcucPartitionRef" type="">
                                <a:da name="MIN" type="XPath" expr="node:when(node:fallback(../../../RmGeneral/RmMultiPartitionSupport,'false') = 'true', '1', '0')"/>
                                <a:da name="EDITABLE" type="XPath">
                                    <a:tst expr="../../RmGeneral/RmMultiPartitionSupport"/>
                                </a:da>
                                <v:ref name="RmEcucPartitionRef" type="REFERENCE">
                                    <a:a name="DESC">
                                        <a:v>
                                        <![CDATA[EN:
                                            <html>
                                                Maps the Rm driver to zero or multiple ECUC partitions to make the
                                                modules API available in this partition. <p/>
                                                Note: Implementation Specific Parameter.<p/>
                                            </html>
                                        ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="LABEL" value="RmEcucPartitionRef" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                    <a:a name="SCOPE" value="ECU"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                    <a:a name="UUID" value="ECUC:e3f1d1df-a8ef-4fee-8a57-1b7808cbc9b5"/>
                                    <a:a name="INVALID" type="XPath">
                                        <a:tst expr="text:uniq(../*, .)" false="Duplicate Partition."/>
                                        <a:tst expr="node:empty(.)" true="Field is empty (Suggestion: Select an EcucPartition reference)."/>
                                        <a:tst expr="not(node:refvalid(.))" true="Invalid EcucPartition reference (Suggestion: Select an EcucPartition reference)."/>
                                    </a:a>
                                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                </v:ref>
                            </v:lst>


                            <v:ctr name="Dma_Mux_Configuration" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>The Direct Memory Access Multiplexer (DMAMUX) routes DMA sources configuration.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="ECUC:b4c76b9f-5064-40e8-9a9e-eccd9a901f3d"/>
                                <a:a name="TAB" value="DMA MUX"/>
                                <a:a name="EDITABLE" type="XPath">
                                    <a:tst expr="../../RmGeneral/RmEnableDmaMuxSupport = 'true'"/>
                                </a:a>
                                <v:var name="Dma_Mux_DevErrorDetect" type="BOOLEAN">
                                    <a:a name="LABEL" value="Dma Mux Development Error Detection"/>
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:
                                                <html>
                                                    <p>Dma_Mux_DevErrorDetect</p>
                                                    <p>Switches the Development Error Detection and Notification ON or OFF.</p>
                                                    Note: Implementation Specific Parameter. <p/>
                                                </html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:da name="EDITABLE" type="XPath" expr="../../../RmGeneral/RmEnableDmaMuxSupport = 'true'"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="NXP"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="ECUC:a7fdb70e-573d-4d83-9a3e-1df45b3c2d08"/>
                                    <a:da name="DEFAULT" value="true"/>
                                </v:var>

                                <v:lst name="Dma_Mux_Module_Config" type="MAP">
                                    <a:a name="LABEL" value="Module Configurations"/>
                                    <a:a name="TAB" value="DMA MUX"/>
                                    <a:da name="EDITABLE" type="XPath" expr="../../../RmGeneral/RmEnableDmaMuxSupport = 'true'"/>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="../../../RmGeneral/RmEnableDmaMuxSupport = 'true' and (num:i(count(*))= 0)"
                                        true ="At least one element must be configured when Dma Mux Support is checked!"/>
                                    </a:da>
                                    <v:ctr name="Dma_Mux_Module_Config" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:
                                                    <html><p>DMA MUX configuration.</p></html>
                                                ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="REQUIRES-INDEX" value="true"/>
                                        <a:a name="UUID" value="ECUC:c38f2876-997f-4a3e-8f9c-892ab65a8300"/>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <v:var name="Dma_Mux_HwInstance" type="ENUMERATION">
                                            <a:a name="LABEL" value="Dma Hardware Instance"/>
                                            <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                Select the Hardware DMA Instance.
                                                NOTE: This is an Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:a10d0dd8-cea0-4094-9312-f9bfda6c16e2"/>
                                            <a:da name="DEFAULT" type="XPath" expr="(ecu:list('Rm.Dma_Mux.DmaHwInstance.List'))[position()=1]"/>
                                            <a:da name="RANGE" type="XPath" expr="ecu:list('Rm.Dma_Mux.DmaHwInstance.List')"/>
                                        </v:var>
    
                                        <v:var name="Dma_Mux_HwChannel" type="ENUMERATION">
                                            <a:a name="LABEL" value="Dma Hardware Channel"/>
                                            <a:a name="DESC">
                                            <a:v>
                                                <![CDATA[EN:<html> Vendor specific:
                                                Select the physical eDMA Channel.
                                                NOTE: This is an Implementation Specific Parameter.
                                                </html>]]>
                                            </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:f8d49a9d-6237-4890-9d2a-efe83d07918f"/>
                                            <a:da name="DEFAULT" type="XPath" expr = "ecu:list(text:replace('Rm.Dma_Mux.INSTANCE.Channel.List' , 'INSTANCE' , node:fallback(./../Dma_Mux_HwInstance,'DMA_INSTANCE_0')))[1]"/>
                                            <a:da name="RANGE" type="XPath" expr="ecu:list(text:replace('Rm.Dma_Mux.INSTANCE.Channel.List' , 'INSTANCE' , node:fallback(./../Dma_Mux_HwInstance,'DMA_INSTANCE_0')))"/>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="count(../../*[(Dma_Mux_HwChannel = node:current()) and (Dma_Mux_HwInstance = node:current()/../Dma_Mux_HwInstance)]) = 1"
                                                false="Duplicate hardware channels in an hardware instance."/>
                                            </a:da>
                                        </v:var>
                                        <v:var name="Dma_Mux_Enable_Trigger" type="BOOLEAN">
                                            <a:a name="LABEL" value="Enable Periodic Trigger Mode"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN: <html> Enables the periodic trigger capability for the triggered DMA channel.
                                                        </html>]]>
                                                </a:v>
                                            </a:a>
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="NXP"/>
                                            <a:a name="SCOPE" value="LOCAL"/>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                            <a:a name="UUID" value="ECUC:e98bba72-2be6-4db1-8b7f-ff2270d26a1a"/>
                                            <a:da name="DEFAULT" value="false"/>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="(node:value(.) = 'false') or (node:containsValue(ecu:list(concat('Rm.Dma_Mux.',node:fallback(node:current()/../Dma_Mux_HwInstance,'DMA_INSTANCE_0'),'.SupportTrigger.List')),node:value(../Dma_Mux_HwChannel)) = 'true')" false="This channel does not support the periodic trigger capability"/>
                                            </a:da>
                                        </v:var>
                                        <v:var name="Dma_Mux_Source0" type="ENUMERATION">
                                            <a:a name="LABEL" value="Dma Mux Source"/>
                                            <a:a name="DESC">
                                                <a:v>
                                                    <![CDATA[EN:
                                                        <html>
                                                            <p>Dma Mux Source</p>
                                                            <p> <p/>
                                                        </html>
                                                    ]]>
                                                </a:v>
