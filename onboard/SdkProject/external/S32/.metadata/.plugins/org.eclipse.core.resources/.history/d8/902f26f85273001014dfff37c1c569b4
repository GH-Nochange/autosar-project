#include "S32K144.h"
#include "CanDrv.h"
#include "clock_manager.h"
#include "interrupt_manager.h"
#include <string.h>
#include <stdio.h>

#define RX_MSG_BUF_SIZE 8

// Buffer để nhận dữ liệu CAN
static flexcan_msgbuff_t s_rxMsgBuf;
static uint8_t s_rxData[RX_MSG_BUF_SIZE];

// Hàm callback khi nhận CAN
void MyCAN_RxCallback(phDriverCan_Channel_t channel,
                      uint32_t msgId,
                      const uint8_t *data,
                      uint8_t len,
                      void *userData)
{
    printf("CAN RX: ID=0x%X, Len=%u, Data=", msgId, len);
    for (uint8_t i = 0; i < len; i++)
        printf("%02X ", data[i]);
    printf("\n");
}

int main(void)
{
    // 1. Khởi tạo Clock
    CLOCK_SYS_Init(g_clockManConfigsArr, CLOCK_MANAGER_CONFIG_CNT,
                   g_clockManCallbacksArr, CLOCK_MANAGER_CALLBACK_CNT);
    CLOCK_SYS_UpdateConfiguration(0U, CLOCK_MANAGER_POLICY_AGREEMENT);

    // 2. Bật Interrupts
    INT_SYS_Init();
    INT_SYS_EnableIRQ(CAN0_ORed_0_15_MB_IRQn);  // Nếu dùng CAN0

    // 3. Khởi tạo CAN
    if (phDriverCan_Init() != EER_OK)
    {
        printf("CAN Init failed\n");
        while (1)
            ;
    }

    // 4. Cấu hình frame nhận
    memset(&s_rxMsgBuf, 0, sizeof(s_rxMsgBuf));
    s_rxMsgBuf.data = s_rxData;
    s_rxMsgBuf.dataLen = RX_MSG_BUF_SIZE;
    s_rxMsgBuf.msgId = 0x123;

    if (phDriverCan_Recv(PH_CAN_CHANNEL_MAIN, MyCAN_RxCallback, &s_rxMsgBuf, NULL) != EER_OK)
    {
        printf("CAN Receive config failed\n");
        while (1)
            ;
    }

    // 5. Gửi một frame mẫu
    uint8_t txData[] = {0x11, 0x22, 0x33, 0x44};
    if (phDriverCan_Send(PH_CAN_CHANNEL_MAIN, 0x123, txData, sizeof(txData)) != EER_OK)
    {
        printf("CAN Send failed\n");
    }
    else
    {
        printf("CAN Send success\n");
    }

    while (1)
    {
        // Main loop – có thể thêm LED blink, xử lý sensor...
    }
}
